# ─────────────────────────────────────────────────────────────
# VisionAttend environment template
# Copy to `.env` (which is git-ignored) and replace every placeholder.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Services refuse to start while any value still contains "replace_with".
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# ── PostgreSQL (used by docker-compose to create the database) ──
POSTGRES_USER=visionattend
POSTGRES_PASSWORD=replace_with_db_password
POSTGRES_DB=visionattend
# Must match the values above. Host is 127.0.0.1 (not "localhost", which Node
# may resolve to IPv6 ::1) when the API runs
# on your machine; docker-compose rewrites it to `postgres` for containers.
DATABASE_URL=postgresql://visionattend:replace_with_db_password@127.0.0.1:5432/visionattend

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=replace_with_redis_password
REDIS_URL=redis://:replace_with_redis_password@127.0.0.1:6379

# ── Authentication (Phase 2) ─────────────────────────────────
# Signs short-lived access tokens. Minimum 32 characters.
# Refresh tokens are opaque random values stored hashed in the DB,
# so they do not need a signing secret.
JWT_SECRET=replace_with_long_random_secret

# ── Development seed (pnpm db:seed) ──────────────────────────
# Shared password for the synthetic demo logins. Minimum 12 characters.
SEED_USER_PASSWORD=replace_with_demo_password

# ── Computer Vision service ──────────────────────────────────
CV_SERVICE_URL=http://127.0.0.1:8000
CV_PORT=8000
# Shared secret for API <-> CV internal calls. Minimum 32 characters.
CV_SERVICE_TOKEN=replace_with_long_random_token

# ── Frontend (Vite exposes only VITE_* variables to the browser) ──
# Leave empty in development: Vite proxies /api to the local API.
VITE_API_URL=
