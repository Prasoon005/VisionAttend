# VisionAttend environment variables.
# Copy to .env.local (never committed) and fill in real values, or, for the
# local Supabase stack, run `npm run env:local` to generate it.
# Names only here, never real secrets. Each variable is documented in docs/SETUP.md.

# Supabase project URL and publishable (browser-safe) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key: SERVER ONLY. Bypasses Row Level Security; used for
# invitations, bans and audit writes. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Public URL of this app, used in email links (e.g. http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
