# ─────────────────────────────────────────────────────────────
# VisionAttend .gitignore
# Code, schema and migrations are committed; secrets, data,
# biometrics and generated artifacts are not.
# ─────────────────────────────────────────────────────────────

# ── Environment / secrets ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
*.tsbuildinfo

# ── Next.js / Vercel ─────────────────────────────────────────
.next/
out/
build/
next-env.d.ts
.vercel/

# ── Supabase CLI local state ─────────────────────────────────
supabase/.branches/
supabase/.temp/

# ── Tests / coverage ─────────────────────────────────────────
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── Logs / temp ──────────────────────────────────────────────
*.log
tmp/
.cache/

# ── Biometric / camera material (NEVER commit) ───────────────
# Face images, embeddings and recordings stay local.
biometrics/
recordings/
captures/
*.npy
*.npz
*.mp4
*.avi
*.mkv

# ── IDE / OS ─────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
