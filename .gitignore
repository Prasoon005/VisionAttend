# ─────────────────────────────────────────────────────────────
# VisionAttend .gitignore
# Rule of thumb: code, schema and migrations are committed;
# secrets, data, biometrics and generated artifacts are not.
# ─────────────────────────────────────────────────────────────

# ── Environment / secrets ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/

# ── Node.js ──────────────────────────────────────────────────
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ── Build output ─────────────────────────────────────────────
dist/
build/
.next/
out/
.vite/
# Prisma-generated client (regenerated by `prisma generate`)
apps/api/src/generated/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Tests / coverage ─────────────────────────────────────────
coverage/
htmlcov/
.coverage
test-results/
playwright-report/

# ── Logs / temp ──────────────────────────────────────────────
*.log
logs/
tmp/
temp/
.cache/

# ── Local data (never commit real or generated data) ─────────
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
*.backup
data/
uploads/
storage/
exports/

# ── Biometric / camera material (NEVER commit) ───────────────
# Face images, embeddings, recordings and model weights stay local.
biometrics/
recordings/
captures/
*.npy
*.npz
*.onnx
*.mp4
*.avi
*.mkv

# ── IDE / editor ─────────────────────────────────────────────
# Keep shareable workspace config, ignore personal settings.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
*~

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
