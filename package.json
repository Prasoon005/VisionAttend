{
  "name": "visionattend",
  "private": true,
  "description": "AI-powered workforce attendance and access management platform",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:shared": "pnpm --filter @visionattend/shared build",
    "dev:api": "pnpm build:shared && pnpm --filter @visionattend/api dev",
    "dev:web": "pnpm build:shared && pnpm --filter @visionattend/web dev",
    "build": "pnpm build:shared && pnpm -r --filter !@visionattend/shared build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:shared && pnpm -r test",
    "db:migrate": "pnpm --filter @visionattend/api db:migrate",
    "db:seed": "pnpm --filter @visionattend/api db:seed",
    "db:studio": "pnpm --filter @visionattend/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
